{
  "identifier": "default",
  "description": "Permissions available to Telegram app content",
  "local": true,
  "webviews": ["*"],
  "permissions": [
    "allow-mark-title-bar-overlay",
    "allow-set-notifications-count",
    "allow-show-desktop-notification",
    "allow-is-app-window-active",
    "allow-activate-desktop-toast",
    "allow-close-desktop-toast",
    "allow-set-window-title",
    "allow-open-new-window-cmd",
    "allow-save-current-url",
    "allow-set-menu-translations",
    "allow-check-github-update",
    "allow-install-github-update",
    "core:event:default",
    "core:window:allow-is-fullscreen",
    "core:window:allow-is-maximized",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-set-theme",
    "process:default",
    "updater:default",
    "notification:allow-is-permission-granted",
    "notification:allow-notify",
    "notification:allow-request-permission",
    "shell:default"
  ]
}
